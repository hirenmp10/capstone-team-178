# /etc/mfw/mfw.env -- read by every mfw-*.service (EnvironmentFile=).
#
# Install: sudo scripts/jetson_mode.sh install   (copies this file to
# /etc/mfw/mfw.env only if that file does not exist yet, then edit it).
#
# systemd does NOT expand ${VAR} inside this file: write every path in full.
# The units hand these to /bin/sh as $$VAR (systemd leaves them to the shell);
# paths are quoted there, but LLAMA_ARGS / MFW_ROBOT_EXTRA are split on
# spaces on purpose. Keep paths free of spaces anyway.

# Repo checkout and the interpreter that has numpy, pyzmq, msgpack, pyserial,
# opencv, onnxruntime-gpu (Jetson build) and the transcribe_cpp binding.
MFW_HOME=/home/jetson/mfw
MFW_PYTHON=/usr/bin/python3

# --- robot_server (jetson/robot_server.py) ---------------------------------
# uno_serial driver name on the CLI is "uno"; "pca9685" for a CH340 clone Uno.
MFW_ARM_DRIVER=uno
MFW_SERIAL=/dev/ttyACM0
# base_height,shoulder_offset,upper_arm,forearm,tool (m). MEASURE: must equal
# hardware.arm in configs/hardware.yaml on the laptop.
MFW_ARM_GEOMETRY=0.07,0.0,0.105,0.10,0.09
# robot_server owns the single USB webcam (get_frame); the detector reads
# frames from it, so nothing else may open /dev/video0.
# jetson/robot_config.yaml ships `measured: false`, and robot_server refuses
# to drive a real arm on it (exit 2). FIRST bench bring-up only, add
# --allow-placeholder-calibration (pulses kept in 1000..2000 us, 0.35 rad/s);
# remove it once calibrate_servos.py has saved `measured: true`.
MFW_ROBOT_EXTRA="--require-camera"

# --- llama-server + shim (Qwen2.5-3B-Instruct Q4_K_M) -----------------------
LLAMA_SERVER=/home/jetson/llama.cpp/build/bin/llama-server
QWEN_GGUF=/home/jetson/models/qwen/qwen2.5-3b-instruct-q4_k_m.gguf
# docs/JETSON_MODELS_PLAN.md: -ngl 99 -c 2048 -np 1 -ub 128 -fa on -lm none
# (llama.cpp pinned at build 11200 / commit 81bc6b83f, jetson/README.md 3a: it
# REJECTS the old --no-mmap and exits 1 -- "-lm none" is its replacement.
# Every token here is checked against tests/data/llama_server_help_b11200.txt.)
LLAMA_ARGS="-ngl 99 -c 2048 -np 1 -ub 128 -fa on -lm none"
LLAMA_PORT=8080

# --- speech (Canary-Qwen-2.5B GGUF Q4_K_M via transcribe.cpp) --------------
CANARY_GGUF=/home/jetson/models/canary/canary-qwen-2.5b-Q4_K_M.gguf
TRANSCRIBE_LIBRARY=/home/jetson/transcribe.cpp/build/bin/libtranscribe.so
# USB microphone index: `python3 scripts/speech_worker.py --list-mics`.
MFW_MIC=0

# --- detector (Florence-2-base ONNX FP16) -----------------------------------
FLORENCE_DIR=/home/jetson/models/florence
FLORENCE_PRECISION=fp16
# Extra serve_detector.py flags, split on spaces. The per-object colour
# prompts (docs/MVP_RUNBOOK.md): "--label-config /etc/mfw/detector_labels.json".
# "--history-max-age 0" makes every detect vote on its own frames only, so the
# scan's three looks are independent (MVP_RUNBOOK section 13); it costs at
# least two Florence inferences per detect. Off by default: unmeasured here.
MFW_DETECTOR_EXTRA=""
